{
  "name": "sv-browser-automate-editor",
  "version": "3.1.114",
  "description": "SV Browser Automate Editor - Visual workflow editor",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"electron .\"",
    "runtime": "electron . --runtime",
    "electron:runtime": "concurrently -k \"vite\" \"electron . --runtime\"",
    "build:electron": "tsc -p tsconfig.electron.json && javascript-obfuscator dist-electron/main.js --output dist-electron/main.js --compact true --control-flow-flattening true --string-array true --string-array-encoding base64",
    "dist:win": "node scripts/prepare-build.js && npm run build && npm run build:electron && electron-builder --win && node scripts/collect-release.cjs",
    "dist:win:nobump": "node scripts/prepare-build.js --no-bump && npm run build && npm run build:electron && electron-builder --win && node scripts/collect-release.cjs",
    "dist:mac": "node scripts/prepare-build.js --no-bump --platform=mac && npm run build && npm run build:electron && electron-builder --mac --publish never && node scripts/collect-release.cjs --mac",
    "release:collect": "node scripts/collect-release.cjs"
  },
  "keywords": [
    "sv-browser",
    "automate",
    "editor",
    "workflow"
  ],
  "author": "SV Browser",
  "license": "ISC",
  "dependencies": {
    "@types/ws": "^8.18.1",
    "bootstrap-icons": "^1.13.1",
    "bytenode": "^1.6.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "bytenode": "^1.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.7.0",
    "postcss": "^8.4.38",
    "rollup-plugin-obfuscator": "^1.1.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.svbrowser.automateeditor",
    "productName": "SV Browser Automate Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "scripts/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "SV-Browser-Automate-Editor-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "SV-Browser-Automate-Editor-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thevien1",
        "repo": "Automate-Editor",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "SV-Browser-Automate-Editor-${version}-mac-${arch}.${ext}",
      "icon": "public/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "SV Browser uses screen capture for image matching in workflows."
      }
    },
    "fileAssociations": [
      {
        "ext": "svblaunch",
        "name": "SV Browser Workflow Package",
        "role": "Editor"
      },
      {
        "ext": "gpmlaunch",
        "name": "Legacy Workflow Package",
        "role": "Editor"
      }
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.py"
        ]
      }
    ]
  }
}
